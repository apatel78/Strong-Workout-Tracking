# Copy to .env for LOCAL development only.
# .env is gitignored. In GitHub Actions these come from repository secrets.

STRONG_USERNAME=your-email@example.com
STRONG_PASSWORD=your-strong-password
STRONG_API_BASE=strong-api-base-url
#To avoid MFA use your own personal device ID
STRONG_DEVICE_ID=your-strong-device-id

# Only change these if the app updates and the server starts rejecting you.
# STRONG_USER_AGENT=Strong iOS
# STRONG_CLIENT_VERSION=6.4.3
# STRONG_CLIENT_BUILD=8343
# STRONG_CLIENT_PLATFORM=ios
# STRONG_EXTRA_HEADERS={"x-app-version":"6.1.0","x-platform":"ios"}
# STRONG_TOKEN=eyJhbGciOi...
# STRONG_USER_ID=your-strong-user-id
# STRONG_TOKEN_HEADER=Authorization
# STRONG_TOKEN_SCHEME=Bearer 

# --- optional overrides -----------------------------------------------------
# STRONG_PAGE_LIMIT=200
# STRONG_WEIGHT_UNIT=lb
# Set to 1 if the API turns out to store kilograms internally:
# STRONG_CONVERT_KG_TO_LB=0
# Set to 1 to count warmup sets toward PRs:
# STRONG_INCLUDE_WARMUP_SETS=0
